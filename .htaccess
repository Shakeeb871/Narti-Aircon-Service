# NARTI Aircon Service — Apache settings (Hostinger / cPanel)
#
# One preferred address for every page:  https://nartiairconservice.com/page/
#   - http  -> https
#   - www   -> no www
#   - /index.html and *.html -> clean URL with a trailing slash
#   - /page -> /page/
# Every redirect is a single 301 straight to the final address.
#
# IMPORTANT: switch on the free SSL certificate in the hosting panel before
# uploading this file, otherwise browsers show a security warning.

Options -Indexes
DirectorySlash On
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# 1. /index.html or /folder/index.html -> /  or /folder/
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ https://nartiairconservice.com/%1 [R=301,L,NE]

# 2. /page.html -> /page/
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ https://nartiairconservice.com/%1/ [R=301,L,NE]

# 3. Add the trailing slash to clean URLs (not to real files like style.css)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^ https://nartiairconservice.com%{REQUEST_URI}/ [R=301,L,NE]

# 4. Anything else on www or http -> https://nartiairconservice.com
RewriteCond %{HTTP_HOST} ^www\.nartiairconservice\.com$ [NC]
RewriteRule ^ https://nartiairconservice.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^nartiairconservice\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://nartiairconservice.com%{REQUEST_URI} [R=301,L,NE]

# 5. Serve /page/ from page.html when there is no page/ folder
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/$ /$1.html [L]

# Server-only files: never served
RedirectMatch 404 ^/server-config/
<Files "db.php">
  Require all denied
</Files>

# Custom "page not found" page
ErrorDocument 404 /404.html

# Keep visitors out of the original image uploads
RedirectMatch 404 ^/source-images/

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml image/x-icon
</IfModule>

# Browser caching. CSS and JS carry a ?v= version, so they can be cached for a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers (OWASP HTTP Headers Cheat Sheet)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  # HSTS: only sent over HTTPS. One year, no preload, so a certificate problem cannot lock visitors out for long.
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
  Header always unset X-Powered-By
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Block access to hidden files such as .git and .env
<IfModule mod_rewrite.c>
  RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>
